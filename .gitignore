.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/


# Run artefacts contain real measured traffic data and an audit trail.
logs/
reports/
results/

# Build output
build/
dist/
*.egg-info/
.ruff_cache/
.mypy_cache/

# TLS material is generated per-machine by `adobo.target --generate-cert` and
# must never be committed. Private keys in a repository are a real finding, not
# a nitpick, even when the certificate is self-signed for a lab.
*.pem
*.key
*.crt

# Local lab policy. These hold per-machine settings rather than defaults, so
# they stay out of the shared repository.
config/

# Personal working notes, not part of the project.
CHECKPOINT.md
PROGRESS.md

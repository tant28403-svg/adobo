.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/


# Run artefacts contain real measured traffic data and an audit trail.
logs/
reports/
results/

# Build output
build/
dist/
*.egg-info/
.ruff_cache/
.mypy_cache/

# TLS material is generated per-machine by `adobo.target --generate-cert` and
# must never be committed. Private keys in a repository are a real finding, not
# a nitpick, even when the certificate is self-signed for a lab.
*.pem
*.key
*.crt

# Local lab policy used to be ignored entirely, which meant config/lab.yaml
# could never be committed and a fresh clone silently fell back to the
# built-in ceilings (max_workers 8) rather than the ones in this file.
# lab.yaml is now tracked so the ceilings a run is clamped to travel with the
# code. Anything else placed in config/ stays ignored.
config/*
!config/lab.yaml

# Personal working notes, not part of the project.
CHECKPOINT.md
PROGRESS.md
